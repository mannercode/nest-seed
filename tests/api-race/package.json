{
    "name": "api-race",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "test": "node --test contracts/*.test.js",
        "lint": "oxlint -c ../../oxlint.json . && prettier --check '*.js' 'contracts/*.test.js' 'probes/*.js' package.json",
        "format": "prettier --write '*.js' 'contracts/*.test.js' 'probes/*.js' package.json",
        "atoz": "pnpm run lint && pnpm test"
    },
    "devDependencies": {
        "@restatedev/restate-sdk": "1.17.0",
        "@restatedev/restate-sdk-clients": "1.17.0"
    }
}
