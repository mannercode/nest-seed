{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "lib": ["dom", "esnext"],
        "types": ["node"]
    },
    "include": [
        "e2e/**/*",
        "contracts/**/*",
        "playwright.config.ts",
        "playwright.contract.config.ts"
    ]
}
