# 먼저 모든 파일을 제외하고, Docker 이미지 빌드에 필요한 파일만 다시 포함한다.
# 패턴이 `/`로 시작해야 루트 파일만 가리켜 다른 폴더의 파일이 잘못 포함되지 않는다.
*

!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json

!/libs/common/package.json
!/libs/common/tsconfig.json
!/libs/common/tsconfig.build.json
!/libs/common/src/
# API의 개발 의존성인 workspace link를 해석하는 데 manifest만 필요하다.
!/libs/testing/package.json

!/apps/api/package.json
!/apps/api/rspack.config.cjs
!/apps/api/tsconfig.json
!/apps/api/tsconfig.build.json
!/apps/api/nest-cli.json
!/apps/api/src/
!/apps/api/scripts/

!/tools/dev-tools/package.json
!/tools/dev-tools/free-port.js
!/tools/dev-tools/tunnel.sh
!/tools/vitest-helpers/package.json

**/node_modules
**/_output
**/__tests__
