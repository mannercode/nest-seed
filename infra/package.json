{
    "name": "infra",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "apps:up": "flock . docker compose -f compose.apps.yml up -d --build --wait",
        "apps:down": "flock . docker compose -f compose.apps.yml --profile '*' down",
        "reset": "bash reset.sh",
        "test": "node --test --test-concurrency=1 --test-reporter=spec",
        "race": "flock . bash tests/api/race/runner.sh",
        "benchmark": "flock . bash tests/api/benchmark/run.sh"
    },
    "devDependencies": {
        "@restatedev/restate-sdk": "1.18.4",
        "@restatedev/restate-sdk-clients": "1.18.4"
    }
}
