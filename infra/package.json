{
    "name": "infra",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#race-common": "./tests/api/race/race-common.js"
    },
    "scripts": {
        "apps:up": "bash compose.sh up",
        "apps:down": "bash compose.sh reset",
        "reset": "bash compose.sh reset",
        "test": "bash compose.sh test restate node --test --test-concurrency=1 --test-reporter=spec",
        "race": "bash tests/api/race/runner.sh",
        "benchmark": "bash compose.sh test nginx bash tests/api/benchmark/run.sh"
    },
    "devDependencies": {
        "@mannercode/testing": "workspace:*",
        "@restatedev/restate-sdk": "1.18.4",
        "@restatedev/restate-sdk-clients": "1.18.4"
    }
}
