{
    "name": "@mannercode/testing",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "lint": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run"
    },
    "dependencies": {
        "superagent": "10.4.2"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/testing": "^12.0.0"
    },
    "devDependencies": {
        "@types/superagent": "8.1.11",
        "vitest": "5.1.1"
    }
}
