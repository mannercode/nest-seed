{
    "name": "@mannercode/testing",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint src/ --max-warnings=0 && prettier --check src/ vitest.config.mjs",
        "format": "eslint src/ --fix && prettier --write src/",
        "test": "vitest run",
        "atoz": "pnpm run build && pnpm run lint && pnpm test"
    },
    "dependencies": {
        "superagent": "10.3.0"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/testing": "^12.0.0"
    },
    "devDependencies": {
        "@types/superagent": "8.1.11",
        "vitest": "4.1.11"
    }
}
