{
    "name": "@mannercode/testing",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "imports": {
        "#testing": {
            "nest-seed-source": "./src/index.ts",
            "default": "./_output/dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "lint": "run-p lint:**",
        "lint:build": "tsc --noEmit -p tsconfig.build.json",
        "lint:test": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@types/superagent": "8.1.11",
        "superagent": "10.4.2"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/platform-express": "^12.0.0",
        "@nestjs/testing": "^12.0.0"
    },
    "devDependencies": {
        "@mannercode/tools": "workspace:*",
        "@types/express": "5.0.6",
        "npm-run-all": "4.1.5",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "vitest": "5.1.1"
    }
}
