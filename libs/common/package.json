{
    "name": "@mannercode/common",
    "version": "0.0.1",
    "private": true,
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json && eslint src/ --max-warnings=0 && prettier --check src/",
        "format": "eslint src/ --fix && prettier --write src/",
        "atoz": "pnpm run build && pnpm run lint && pnpm test"
    },
    "dependencies": {
        "winston": "3.19.0",
        "winston-daily-rotate-file": "5.0.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@aws-sdk/s3-presigned-post": "^3.0.0",
        "@aws-sdk/s3-request-presigner": "^3.0.0",
        "@nats-io/transport-node": "^3.4.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/jwt": "^12.0.0",
        "@nestjs/mongoose": "^12.0.0",
        "class-transformer": "^0.5.0",
        "class-validator": "^0.15.0",
        "express": "^5.0.0",
        "ioredis": "^6.0.0",
        "mongoose": "^9.0.0",
        "rxjs": "^7.0.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1116.0",
        "@mannercode/jest-helpers": "workspace:*",
        "@mannercode/testing": "workspace:*",
        "@testcontainers/mongodb": "12.1.0",
        "@testcontainers/nats": "12.1.0",
        "ioredis": "6.0.0",
        "mongodb": "7.5.0",
        "testcontainers": "12.1.0",
        "ts-jest": "29.4.12"
    }
}
