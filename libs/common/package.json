{
    "name": "@mannercode/common",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "files": [
        "_output/dist"
    ],
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "test": "vitest run --coverage",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint src/ --max-warnings=0 && prettier --check src/ vitest.config.mjs",
        "format": "eslint src/ --fix && prettier --write src/",
        "atoz": "pnpm run build && pnpm run lint && pnpm test"
    },
    "dependencies": {
        "winston": "3.19.0",
        "winston-daily-rotate-file": "5.0.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@aws-sdk/s3-presigned-post": "^3.0.0",
        "@aws-sdk/s3-request-presigner": "^3.0.0",
        "@nats-io/transport-node": "^3.4.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/jwt": "^12.0.0",
        "express": "^5.0.0",
        "ioredis": "^6.0.0",
        "mongodb": "^7.0.0",
        "rxjs": "^7.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1116.0",
        "@mannercode/testing": "workspace:*",
        "@mannercode/vitest-helpers": "workspace:*",
        "@testcontainers/mongodb": "12.1.0",
        "@testcontainers/nats": "12.1.0",
        "ioredis": "6.0.0",
        "mongodb": "7.5.0",
        "testcontainers": "12.1.0",
        "vitest": "4.1.11",
        "zod": "4.5.2"
    }
}
