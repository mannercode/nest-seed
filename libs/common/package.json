{
    "name": "@mannercode/common",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "files": [
        "_output/dist"
    ],
    "main": "_output/dist/index.js",
    "types": "_output/dist/index.d.ts",
    "imports": {
        "#common": {
            "nest-seed-source": "./src/index.ts",
            "default": "./_output/dist/index.js"
        },
        "#common/*": {
            "nest-seed-source": "./src/*/index.ts",
            "default": "./_output/dist/*/index.js"
        },
        "#common/connection-registry": {
            "nest-seed-source": "./src/connection-registry.ts",
            "default": "./_output/dist/connection-registry.js"
        },
        "#common/transaction": {
            "nest-seed-source": "./src/transaction.ts",
            "default": "./_output/dist/transaction.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "test": "bash \"${WORKSPACE_ROOT:?}/infra/test.sh\" -- vitest run --coverage",
        "lint": "run-p lint:**",
        "lint:build": "tsc --noEmit -p tsconfig.build.json",
        "lint:test": "tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@elastic/ecs-winston-format": "1.5.3",
        "@types/express": "5.0.6",
        "@types/redis-errors": "1.2.3",
        "winston": "3.19.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@aws-sdk/s3-presigned-post": "^3.0.0",
        "@aws-sdk/s3-request-presigner": "^3.0.0",
        "@nats-io/jetstream": "^3.4.0",
        "@nats-io/transport-node": "^3.4.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/jwt": "^12.0.0",
        "@restatedev/restate-sdk": "^1.17.0",
        "@restatedev/restate-sdk-clients": "^1.17.0",
        "argon2": "^0.45.1",
        "express": "^5.0.0",
        "ioredis": "^6.0.0",
        "mongodb": "^7.0.0",
        "rxjs": "^7.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1175.0",
        "@mannercode/testing": "workspace:*",
        "@mannercode/tools": "workspace:*",
        "@nats-io/jetstream": "3.5.0",
        "@nestjs/testing": "12.6.0",
        "@restatedev/restate-sdk": "1.18.4",
        "@restatedev/restate-sdk-clients": "1.18.4",
        "@testcontainers/mongodb": "12.2.2",
        "@testcontainers/nats": "12.2.2",
        "argon2": "0.45.2",
        "ioredis": "6.1.0",
        "mongodb": "7.9.1",
        "npm-run-all": "4.1.5",
        "reflect-metadata": "0.2.2",
        "testcontainers": "12.2.2",
        "vitest": "5.1.1",
        "zod": "4.6.7"
    }
}
