{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        // Nest CLI의 path transformer가 `#alias`를 소스 `.ts` 경로로 바꾸므로 ESM 산출물에서 `.js`로 다시 쓴다.
        "rewriteRelativeImportExtensions": true,
        // "ESNext"는 TS 버전마다 의미가 바뀌어 emit/타입이 흔들린다.
        // Node 26에서 안전한 구체 에디션으로 고정한다.
        "target": "ES2024",
        "lib": ["ES2024"],
        "types": ["node"],

        "strict": true,
        // DTO와 저장 모델은 class-transformer·ODM이 생성 뒤 필드를 채우므로 생성자 초기화를 두지 않는다.
        "strictPropertyInitialization": false,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        // Rspack의 transpileOnly처럼 파일별로 변환해도 안전한 import/type 경계를 타입 검사에서 보장한다.
        "isolatedModules": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "sourceMap": true,

        "skipLibCheck": true
    }
}
