{
    "name": "${containerWorkspaceFolderBasename}",
    "build": { "dockerfile": "Dockerfile", "context": ".." },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": false,
            "dockerDashComposeVersion": "none"
        },
        "ghcr.io/devcontainers/features/github-cli": {}
    },
    "runArgs": [
        "--env-file",
        ".env.infra",
        "--env-file",
        ".env.api",
        "--name=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}",
        "--network=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}"
    ],
    "remoteUser": "node",
    "containerEnv": {
        "WORKSPACE_ROOT": "${containerWorkspaceFolder}",
        "COMPOSE_PROJECT_NAME": "${localEnv:USER:unknown}-${localWorkspaceFolderBasename}",
        "DEVCONTAINER_NETWORK": "${localEnv:USER:unknown}-${localWorkspaceFolderBasename}"
    },
    // docker-outside-of-docker는 호스트 daemon을 사용하기 때문에 workspace를 같은 절대 경로에 마운트한다.
    "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
    "workspaceFolder": "${localWorkspaceFolder}",
    "mounts": [
        "source=${localEnv:HOME}/.codex/${localWorkspaceFolderBasename},target=/home/node/.codex,type=bind",
        "source=${localEnv:HOME}/.codex,target=/home/node/.codex-shared,type=bind",
        "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
    ],
    "initializeCommand": {
        "project-network": "n=${localEnv:USER:unknown}-${localWorkspaceFolderBasename}; docker network inspect \"$n\" >/dev/null 2>&1 || docker network create \"$n\" >/dev/null",
        "codex": "mkdir -p \"${localEnv:HOME}/.codex/${localWorkspaceFolderBasename}\" \"${localEnv:HOME}/.codex/skills\"",
        "github": "mkdir -p ${localEnv:HOME}/.config/gh"
    },
    "postCreateCommand": "for entry in config.toml auth.json skills; do ln -sfn \"/home/node/.codex-shared/$entry\" \"/home/node/.codex/$entry\" || exit; done",
    "postStartCommand": "pnpm install --frozen-lockfile && pnpm --filter './tests/web' exec playwright install chromium && bash infra/reset.sh",
    "waitFor": "postStartCommand",
    "customizations": {
        "vscode": {
            "extensions": [
                // 이름과 달리 Vitest도 자동 감지한다. 이 저장소에서는 Vitest spec의 실행·디버깅에 사용한다.
                "firsttris.vscode-jest-runner",
                "esbenp.prettier-vscode",
                "mutantdino.resourcemonitor",
                "mkhl.shfmt"
            ],
            "settings": { "remote.autoForwardPorts": false }
        }
    }
}
