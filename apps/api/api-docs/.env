# run.sh가 source 하므로 bash 기본값 문법을 사용할 수 있다.
# 외부 호출자가 SERVER_URL을 export하면 그 값을 우선한다.
# tests/api/runner.sh는 Docker 네트워크 안에서 nginx 서비스 이름(http://nginx)을 넘긴다.
SERVER_URL="${SERVER_URL:-http://localhost:${API_PORT:?}}"

# infra/reset.sh가 만든 고정 admin fixture로 인증한다.
# shellcheck source=../../../.env.seed
. ../../../.env.seed

# 환경별 SHA-256 CLI 차이를 피하려고 fixture 크기와 checksum을 미리 계산해 고정한다.
ASSET_IMAGE_PATH=./assets/image.png
ASSET_IMAGE_ORIGINAL_NAME=image.png
ASSET_IMAGE_SIZE=170550
ASSET_IMAGE_SHA256_BASE64=d5l1XdGa5zgerERd5V5xMR0X0mbMoZvJL1liTH1to2A=
