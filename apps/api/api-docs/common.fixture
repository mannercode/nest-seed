#!/bin/bash

random_email() {
	printf "test.%s.%s@example.com\n" "$(date +%s%N)" "${RANDOM}"
}

RESPONSE_BODY() {
	jq -er --arg path "$1" 'getpath($path | split("."))' <<<"${BODY}"
}

USER_NAME="사용자 이름"
USER_BIRTHDATE="1990-01-01"
USER_PASSWORD="Example password 1!"

create_user() {
	USER_EMAIL=$(random_email)

	SETUP 201 POST /users \
		-H 'Content-Type: application/json' \
		-d '{
				"name": "'"${USER_NAME}"'",
				"birthDate": "'"${USER_BIRTHDATE}"'",
				"email": "'"${USER_EMAIL}"'",
				"password": "'"${USER_PASSWORD}"'"
			}'
}

login_user() {
	SETUP 200 POST /users/login \
		-H 'Content-Type: application/json' \
		-d '{ "email": "'"${USER_EMAIL}"'", "password": "'"${USER_PASSWORD}"'" }'

	CURRENT_AUTH_TOKEN=$(RESPONSE_BODY accessToken)
}

create_and_login_user() {
	create_user
	login_user
}

as_guest() {
	unset CURRENT_AUTH_TOKEN
}

upload_presigned_post() {
	local filePath=$1
	local uploadInfo=$2
	local URL METHOD fields
	URL=$(jq -er '.url' <<<"${uploadInfo}")
	METHOD=$(jq -er '.method' <<<"${uploadInfo}")
	fields=$(jq -er '.fields | to_entries[] | [.key, .value] | @tsv' <<<"${uploadInfo}")

	local -a formArgs=()
	while IFS=$'\t' read -r key value; do
		formArgs+=(--form-string "${key}=${value}")
	done <<<"${fields}"
	formArgs+=(-F "file=@${filePath}")

	CURL "${METHOD}" "${URL}" "${formArgs[@]}"

	if [[ "${STATUS}" -ge 300 ]]; then
		LOG_LINE "# 업로드 실패"
		LOG_LINE "실제=${STATUS}"
		exit 2
	fi
}

as_guest
