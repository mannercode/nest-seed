{
    "name": "api",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "imports": {
        "#application": "./_output/build/src/services/application/index.js",
        "#config": "./_output/build/src/config/index.js",
        "#core": "./_output/build/src/services/core/index.js",
        "#gateway": "./_output/build/src/services/gateway/index.js",
        "#infrastructure": "./_output/build/src/services/infrastructure/index.js",
        "#view": "./_output/build/src/services/view/index.js"
    },
    "scripts": {
        "start": "node --enable-source-maps _output/dist/index.js",
        "format": "eslint src/ scripts/ '*.cjs' --fix && prettier --write src/ scripts/ '*.cjs'",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint src/ scripts/ '*.cjs' --max-warnings=0 && prettier --check src/ scripts/ '*.{cjs,mjs}'",
        "build": "nest build -b rspack --rspackPath rspack.config.cjs",
        "predev": "free-port ${API_PORT:?}",
        "dev": "nest start --watch",
        "test": "vitest run --coverage",
        "test:api-docs-redaction": "bash api-docs/redaction.test.sh",
        "test:vitest-isolation": "node --test scripts/__tests__/*.test.cjs",
        "atoz": "pnpm run lint && pnpm run test:api-docs-redaction && pnpm run test:vitest-isolation && pnpm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1118.0",
        "@aws-sdk/s3-presigned-post": "3.1118.0",
        "@aws-sdk/s3-request-presigner": "3.1118.0",
        "@mannercode/common": "workspace:*",
        "@nats-io/jetstream": "3.4.0",
        "@nats-io/transport-node": "3.4.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/config": "12.0.0",
        "@nestjs/core": "12.0.1",
        "@nestjs/jwt": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schedule": "12.0.1",
        "@restatedev/restate-sdk": "1.16.9",
        "@restatedev/restate-sdk-clients": "1.16.9",
        "bcrypt": "6.0.0",
        "compression": "1.8.1",
        "express": "5.2.1",
        "ioredis": "6.0.0",
        "mongodb": "7.5.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.5.2"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@mannercode/dev-tools": "workspace:*",
        "@mannercode/testing": "workspace:*",
        "@mannercode/vitest-helpers": "workspace:*",
        "@nestjs/cli": "12.0.0",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@rspack/core": "2.2.1",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/node": "26.4.0",
        "@vitest/eslint-plugin": "1.6.27",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "fork-ts-checker-webpack-plugin": "9.1.0",
        "globals": "17.11.0",
        "prettier": "3.9.6",
        "ts-loader": "9.6.2",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vitest": "4.1.11",
        "webpack": "5.110.1",
        "webpack-node-externals": "3.0.0"
    }
}
