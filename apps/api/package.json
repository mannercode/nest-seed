{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node --enable-source-maps _output/dist/index.js",
        "lint": "tsc --noEmit",
        "build": "nest build -b rspack --rspackPath rspack.config.cjs",
        "predev": "pnpm --filter-prod 'api^...' --fail-if-no-match run build",
        "dev": "nest start --watch",
        "test": "run-s test:**",
        "test:vitest": "flock . vitest run --coverage",
        "test:api-docs": "flock \"${WORKSPACE_ROOT:?}/infra\" bash api-docs/test.sh"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1175.0",
        "@aws-sdk/s3-presigned-post": "3.1175.0",
        "@aws-sdk/s3-request-presigner": "3.1175.0",
        "@mannercode/common": "workspace:*",
        "@nats-io/jetstream": "3.5.0",
        "@nats-io/transport-node": "3.5.0",
        "@nestjs/common": "12.6.0",
        "@nestjs/config": "12.1.1",
        "@nestjs/core": "12.6.0",
        "@nestjs/jwt": "12.0.5",
        "@nestjs/platform-express": "12.6.0",
        "@nestjs/schedule": "12.0.4",
        "@restatedev/restate-sdk": "1.18.4",
        "@restatedev/restate-sdk-clients": "1.18.4",
        "argon2": "0.45.2",
        "compression": "1.8.2",
        "express": "5.3.0",
        "ioredis": "6.0.0",
        "mongodb": "7.9.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@mannercode/testing": "workspace:*",
        "@mannercode/tools": "workspace:*",
        "@nestjs/cli": "12.0.15",
        "@nestjs/schematics": "12.0.16",
        "@nestjs/testing": "12.6.0",
        "@rspack/core": "2.3.3",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "fork-ts-checker-webpack-plugin": "9.2.0",
        "npm-run-all": "4.1.5",
        "ts-loader": "9.6.2",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "6.0.3",
        "vitest": "5.1.1",
        "webpack": "5.113.0",
        "webpack-node-externals": "3.0.0"
    }
}
