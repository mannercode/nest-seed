{
    "name": "api",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "imports": {
        "#application": "./_output/build/src/services/application/index.js",
        "#config": "./_output/build/src/config/index.js",
        "#core": "./_output/build/src/services/core/index.js",
        "#gateway": "./_output/build/src/services/gateway/index.js",
        "#infrastructure": "./_output/build/src/services/infrastructure/index.js",
        "#view": "./_output/build/src/services/view/index.js"
    },
    "scripts": {
        "admin:create": "node scripts/admin-create.cjs",
        "start": "node --enable-source-maps _output/dist/index.js",
        "format": "prettier --write src/ scripts/ '*.{cjs,mjs}'",
        "lint": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json && oxlint -c \"${WORKSPACE_ROOT:?}/oxlint.config.mts\" src/ scripts/ ./*.cjs ./*.mjs && prettier --check src/ scripts/ '*.{cjs,mjs}'",
        "build": "nest build -b rspack --rspackPath rspack.config.cjs",
        "predev": "free-port ${API_PORT:?}",
        "dev": "nest start --watch",
        "test": "vitest run --coverage",
        "atoz": "pnpm run lint && pnpm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1137.0",
        "@aws-sdk/s3-presigned-post": "3.1137.0",
        "@aws-sdk/s3-request-presigner": "3.1137.0",
        "@mannercode/common": "workspace:*",
        "@nats-io/jetstream": "3.4.0",
        "@nats-io/transport-node": "3.4.0",
        "@nestjs/common": "12.0.4",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.0.4",
        "@nestjs/jwt": "12.0.2",
        "@nestjs/platform-express": "12.0.4",
        "@nestjs/schedule": "12.0.2",
        "@restatedev/restate-sdk": "1.17.2",
        "@restatedev/restate-sdk-clients": "1.17.2",
        "bcrypt": "6.0.0",
        "compression": "1.8.2",
        "express": "5.2.1",
        "ioredis": "6.0.0",
        "mongodb": "7.6.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@mannercode/dev-tools": "workspace:*",
        "@mannercode/testing": "workspace:*",
        "@mannercode/vitest-helpers": "workspace:*",
        "@nestjs/cli": "12.0.5",
        "@nestjs/schematics": "12.0.5",
        "@nestjs/testing": "12.0.4",
        "@rspack/core": "2.2.5",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/node": "26.5.1",
        "fork-ts-checker-webpack-plugin": "9.1.0",
        "prettier": "3.9.6",
        "ts-loader": "9.6.2",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "6.0.3",
        "vitest": "5.0.1",
        "webpack": "5.111.0",
        "webpack-node-externals": "3.0.0"
    }
}
