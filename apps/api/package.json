{
    "name": "api",
    "version": "0.0.2",
    "private": true,
    "scripts": {
        "start": "node --enable-source-maps _output/dist/index.js",
        "format": "eslint src/ scripts/ '*.js' --fix && prettier --write src/ scripts/ '*.js'",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json && eslint src/ scripts/ '*.js' --max-warnings=0 && prettier --check src/ scripts/ '*.js'",
        "build": "nest build -b webpack && npm run bundle-workflows",
        "bundle-workflows": "ts-node --transpile-only scripts/bundle-workflows.ts",
        "predev": "free-port ${API_PORT:?} && npm run bundle-workflows",
        "dev": "nest start --watch",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
        "test:api-docs-redaction": "bash api-docs/redaction.test.sh",
        "test:jest-isolation": "node --test scripts/__tests__/*.test.js",
        "atoz": "npm run lint && npm run test:api-docs-redaction && npm run test:jest-isolation && npm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1116.0",
        "@aws-sdk/s3-presigned-post": "3.1116.0",
        "@aws-sdk/s3-request-presigner": "3.1116.0",
        "@mannercode/common": "*",
        "@mannercode/temporal-sandbox": "*",
        "@nestjs/common": "11.2.1",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.1",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/mapped-types": "2.1.1",
        "@nestjs/mongoose": "11.0.4",
        "@nestjs/platform-express": "11.2.1",
        "@nestjs/schedule": "6.1.3",
        "@nestjs/terminus": "11.1.1",
        "@temporalio/activity": "1.22.0",
        "@temporalio/client": "1.22.0",
        "@temporalio/worker": "1.22.0",
        "@temporalio/workflow": "1.22.0",
        "bcrypt": "6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "compression": "1.8.1",
        "express": "5.2.1",
        "ioredis": "6.0.0",
        "joi": "18.2.5",
        "mongoose": "9.9.3",
        "nats": "2.29.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@mannercode/dev-tools": "*",
        "@mannercode/jest-helpers": "*",
        "@mannercode/testing": "*",
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.2.1",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.3",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-jest": "29.16.1",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "globals": "17.11.0",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "ts-jest": "29.4.12",
        "ts-loader": "9.6.2",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    }
}
