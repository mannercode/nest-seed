{
    "name": "api",
    "version": "0.0.2",
    "private": true,
    "scripts": {
        "start": "node --enable-source-maps _output/dist/index.js",
        "format": "eslint src/ scripts/ '*.js' --fix && prettier --write src/ scripts/ '*.js'",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json && eslint src/ scripts/ '*.js' --max-warnings=0 && prettier --check src/ scripts/ '*.js'",
        "build": "nest build -b webpack",
        "predev": "free-port ${API_PORT:?}",
        "dev": "nest start --watch",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
        "test:api-docs-redaction": "bash api-docs/redaction.test.sh",
        "test:jest-isolation": "node --test scripts/__tests__/*.test.js",
        "atoz": "npm run lint && npm run test:api-docs-redaction && npm run test:jest-isolation && npm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1116.0",
        "@aws-sdk/s3-presigned-post": "3.1116.0",
        "@aws-sdk/s3-request-presigner": "3.1116.0",
        "@mannercode/common": "*",
        "@nats-io/transport-node": "3.4.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/config": "12.0.0",
        "@nestjs/core": "12.0.1",
        "@nestjs/jwt": "12.0.1",
        "@nestjs/mapped-types": "12.0.0",
        "@nestjs/mongoose": "12.0.0",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schedule": "12.0.1",
        "@restatedev/restate-sdk": "1.16.9",
        "@restatedev/restate-sdk-clients": "1.16.9",
        "bcrypt": "6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "compression": "1.8.1",
        "express": "5.2.1",
        "ioredis": "6.0.0",
        "joi": "18.2.5",
        "mongoose": "9.9.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@mannercode/dev-tools": "*",
        "@mannercode/jest-helpers": "*",
        "@mannercode/testing": "*",
        "@nestjs/cli": "12.0.0",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "26.4.0",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-jest": "29.16.1",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "fork-ts-checker-webpack-plugin": "9.1.0",
        "globals": "17.11.0",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "ts-jest": "29.4.12",
        "ts-loader": "9.6.2",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "webpack": "5.110.1",
        "webpack-node-externals": "3.0.0"
    }
}
