{
    "name": "user-app",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "free-port ${USER_APP_PORT:?}",
        "dev": "next dev -p ${USER_APP_PORT:?}",
        "build": "next build",
        "prestart": "free-port ${USER_APP_PORT:?}",
        "start": "next start -p ${USER_APP_PORT:?}",
        "format": "eslint src/ --fix && prettier --write src/",
        "lint": "tsc --noEmit && eslint src/ --max-warnings=0 && prettier --check src/",
        "atoz": "npm run lint && npm run build"
    },
    "dependencies": {
        "next": "16.3.2",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@mannercode/dev-tools": "*",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.4.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "eslint-config-next": "16.3.2",
        "postcss": "8.5.26",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3"
    }
}
