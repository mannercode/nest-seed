{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tools",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:toolCommand}"]
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:testCommand}"]
        }
    ],
    "inputs": [
        {
            "id": "toolCommand",
            "type": "pickString",
            "description": "tool",
            "options": ["pnpm run build", "pnpm run lint", "pnpm run format", "pnpm exec tunnel"]
        },
        {
            "id": "testCommand",
            "type": "pickString",
            "description": "test",
            "options": ["pnpm run dev", "pnpm test", "pnpm run atoz"]
        }
    ]
}
