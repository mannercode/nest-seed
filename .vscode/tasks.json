{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tools",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:toolCommand}"]
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:testCommand}"]
        }
    ],
    "inputs": [
        {
            "id": "toolCommand",
            "type": "pickString",
            "description": "tool",
            "options": ["pnpm run build", "pnpm run lint", "pnpm run format", "pnpm run tunnel"]
        },
        {
            "id": "testCommand",
            "type": "pickString",
            "description": "test",
            "options": [
                "pnpm run dev",
                "pnpm test",
                "pnpm -C infra run race jwt-refresh-race",
                "pnpm -C infra run race replica-chaos",
                "pnpm -C infra run race sse-fanout-race",
                "pnpm -C infra run race user-signup-race",
                "pnpm -C infra run benchmark"
            ]
        }
    ]
}
