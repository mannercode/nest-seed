{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tools",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:toolCommand}"]
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "${input:testCommand}"]
        }
    ],
    "inputs": [
        {
            "id": "toolCommand",
            "type": "pickString",
            "description": "tool",
            "options": [
                "npm run build",
                "npm run clean",
                "npm run lint",
                "npm run format",
                "npx tunnel"
            ]
        },
        {
            "id": "testCommand",
            "type": "pickString",
            "description": "test",
            "options": ["npm run dev", "npm test", "npm run atoz"]
        }
    ]
}
