S3_IMAGE=versity/versitygw:v1.7.0@sha256:c4cbd9d9cb8dedbb055ac788dbd02635651b9b1cebac95b095b3217231aa87ad
# @testcontainers/mongodb는 MONGO_IMAGE의 tag를 semver로 읽어 mongosh 사용 여부를 정하므로 digest를 분리한다.
# Compose는 두 값을 다시 `tag@digest`로 결합한다.
MONGO_IMAGE=mongo:8.3.8
MONGO_IMAGE_DIGEST=sha256:5211c51171f57ae60842b11664bb244628971b3d35325762a97888337b9bb0db
NATS_IMAGE=nats:2.14.5-alpine@sha256:d4ac35882ac65aff236cd65b9d3fa4d24332c681e1a85f94eedccd3cdd65b1da
REDIS_IMAGE=redis:8.10.0-alpine@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241
RESTATE_IMAGE=docker.restate.dev/restatedev/restate:1.7.8@sha256:42a2591c178f34e1b7ee43328ee22141a62ea481417a0f144732c45724b5b54a

# 아래 접속 값의 호스트·포트는 compose가 보간해 주는 값이 아니라 infra/compose.*.yml 서비스 정의와 짝을 이루는 리터럴이다.
# env 파일은 자기 보간이 안 되므로 한쪽을 바꾸면 다른 쪽도 같이 바꾼다. 짝 지도는 docs/reference/environment.md의 포트 표 참고.
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=mongo
MONGO_DATABASE=nest-seed-db

REDIS_HOST1=redis1
REDIS_PORT1=6379
REDIS_HOST2=redis2
REDIS_PORT2=6379
REDIS_HOST3=redis3
REDIS_PORT3=6379

S3_ENDPOINT=http://s3:7070
S3_REGION=us-east-1
S3_BUCKET=nest-seed-bucket
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_FORCE_PATH_STYLE=true

NATS_HOST=nats
NATS_PORT=4222

RESTATE_INGRESS_URL=http://restate:8080
RESTATE_ADMIN_URL=http://restate:9070
RESTATE_SERVICE_PORT=9080

# devcontainer가 --env-file로 주입해 pnpm 스크립트·Tunnel·Playwright·API 테스트 Compose가 읽는다.
API_PORT=3000
CONSOLE_PORT=3100
USER_APP_PORT=3200

# infra/reset.sh와 외부 테스트가 함께 쓰는 고정 개발 admin.
ADMIN_EMAIL=admin@nest-seed.local
ADMIN_NAME=Admin
ADMIN_PASSWORD=DevPass1!
