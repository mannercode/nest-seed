MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
# @testcontainers/mongodb는 MONGO_IMAGE의 tag를 semver로 읽어 mongosh 사용 여부를 정하므로 digest를 분리한다.
# Compose는 두 값을 다시 `tag@digest`로 결합한다.
MONGO_IMAGE=mongo:8.3.8
MONGO_IMAGE_DIGEST=sha256:5211c51171f57ae60842b11664bb244628971b3d35325762a97888337b9bb0db
NATS_IMAGE=nats:2.14.5-alpine@sha256:d4ac35882ac65aff236cd65b9d3fa4d24332c681e1a85f94eedccd3cdd65b1da
REDIS_IMAGE=redis:8.10.0-alpine@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241
TEMPORAL_SERVER_IMAGE=temporalio/server:1.31.2@sha256:b5ecdb8282bededae2a10c36e8d862e27d0bc2d247fc73c5416025997ab4a1da
TEMPORAL_ADMIN_TOOLS_IMAGE=temporalio/admin-tools:1.31.2@sha256:dbc5fcd6ee8f0f4d808bf765af9a87dea9d8a283abfdcfbd2fc148496ba66107
TEMPORAL_POSTGRES_IMAGE=postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15

# 아래 접속 값의 호스트·포트는 compose가 보간해 주는 값이 아니라 infra/compose.*.yml 서비스 정의와 짝을 이루는 리터럴이다.
# env 파일은 자기 보간이 안 되므로 한쪽을 바꾸면 다른 쪽도 같이 바꾼다. 짝 지도는 docs/reference/environment.md의 포트 표 참고.
MONGO_URI=mongodb://mongo1:27016,mongo2:27016,mongo3:27016/?replicaSet=mongo
MONGO_DATABASE=nest-seed-db

REDIS_HOST1=redis1
REDIS_PORT1=6379
REDIS_HOST2=redis2
REDIS_PORT2=6379
REDIS_HOST3=redis3
REDIS_PORT3=6379

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nest-seed-bucket
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_FORCE_PATH_STYLE=true
S3_CONSOLE_ENDPOINT=http://localhost:9001

NATS_HOST=nats
NATS_PORT=4222

TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=nest-seed

# dev 서버 포트의 단일 정의처.
# devcontainer가 --env-file로 주입해 npm 스크립트·tunnel.sh·playwright·deploy compose가 모두 이 값을 읽는다.
API_PORT=3000
CONSOLE_PORT=3100
USER_APP_PORT=3200
