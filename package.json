{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "admin:create": "pnpm --filter './libs/common' --fail-if-no-match run build && pnpm --filter './apps/api' --fail-if-no-match run build && pnpm --filter './apps/api' --fail-if-no-match run admin:create",
        "prepare": "husky",
        "build": "pnpm --recursive --if-present run build",
        "compose:tools": "DEVCONTAINER_NETWORK=\"${COMPOSE_PROJECT_NAME:?}\" docker compose --project-name \"$COMPOSE_PROJECT_NAME-tools\" -f tools/compose.yml",
        "prelint": "pnpm --recursive --filter './libs/**' --fail-if-no-match run build",
        "lint": "pnpm --recursive --if-present run lint && pnpm run lint:root",
        "lint:root": "prettier --check . && pnpm compose:tools run --rm lychee && pnpm run lint:shell",
        "lint:shell": "shellcheck --severity=warning -x .github/scripts/*.sh .husky/commit-msg .husky/pre-commit apps/api/api-docs/*.sh apps/api/api-docs/*.spec infra/*.sh tests/api/*.sh tests/api/benchmark/*.sh tests/api/race/*.sh tests/web/*.sh tools/dev-tools/*.sh",
        "format": "prettier --write .",
        "pretest": "pnpm --recursive --filter './libs/**' --workspace-concurrency=1 --fail-if-no-match run build",
        "test": "pnpm --recursive --workspace-concurrency=1 --if-present run test",
        "e2e": "pnpm --filter './tests/web' --fail-if-no-match run e2e",
        "e2e:list": "pnpm --filter './tests/web' --fail-if-no-match run e2e:list",
        "e2e:ui": "pnpm --filter './tests/web' --fail-if-no-match run e2e:ui",
        "e2e:report": "pnpm --filter './tests/web' --fail-if-no-match run e2e:report",
        "race": "bash tests/api/race/runner.sh",
        "benchmark:api": "bash tests/api/benchmark/runner.sh",
        "preatoz": "pnpm install --frozen-lockfile && bash infra/reset.sh",
        "atoz": "pnpm --recursive --workspace-concurrency=1 --if-present run atoz && pnpm run lint:root && bash tests/api/runner.sh",
        "predev": "pnpm --recursive --filter './libs/**' --fail-if-no-match run build",
        "dev": "concurrently 'pnpm:dev:*'",
        "dev:common": "pnpm --filter './libs/common' --fail-if-no-match run dev",
        "dev:api": "pnpm --filter './apps/api' --fail-if-no-match run dev",
        "dev:restate": "node apps/api/scripts/register-restate.cjs",
        "dev:console": "pnpm --filter './apps/console' --fail-if-no-match run dev",
        "dev:user-app": "pnpm --filter './apps/user-app' --fail-if-no-match run dev"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1121.0",
        "@aws-sdk/s3-presigned-post": "3.1121.0",
        "@aws-sdk/s3-request-presigner": "3.1121.0",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@mannercode/dev-tools": "workspace:*",
        "@nestjs/common": "12.0.1",
        "@nestjs/config": "12.0.0",
        "@nestjs/core": "12.0.1",
        "@nestjs/jwt": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@testcontainers/mongodb": "12.1.0",
        "@testcontainers/nats": "12.1.0",
        "@types/express": "5.0.6",
        "@types/node": "26.4.0",
        "@vitest/coverage-v8": "4.1.11",
        "concurrently": "10.0.5",
        "express": "5.2.1",
        "husky": "9.1.7",
        "ioredis": "6.0.0",
        "lint-staged": "17.4.1",
        "mongodb": "7.6.0",
        "oxlint": "1.80.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.1.0",
        "typescript": "6.0.3",
        "vitest": "4.1.11"
    }
}
