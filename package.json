{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "comments": {
        "workspaces": [
            "workspaces 항목 순서 = 빌드 순서. 의존성이 먼저 오도록 유지할 것."
        ]
    },
    "workspaces": [
        "libs/temporal-sandbox",
        "libs/common",
        "libs/testing",
        "tools/*",
        "apps/*",
        "tests/*"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "npm run build --workspaces --if-present",
        "clean": "node tools/clean-workspace.mjs",
        "lint": "npm run lint --workspaces --if-present",
        "postlint": "prettier --check . && lychee --offline --include-fragments '*.md' 'docs/**/*.md' && node tools/lint-shell.mjs",
        "format": "npm run format --workspaces --if-present",
        "postformat": "prettier --write .",
        "pretest": "npm run build -w libs",
        "test": "npm test --workspaces --if-present",
        "e2e": "npm run e2e -w tests/console-e2e",
        "preatoz": "npm run clean && bash infra/reset.sh && for i in 1 2 3 4 5; do npm ci && break; [ $i = 5 ] && exit 1; sleep $((i*10)); done",
        "atoz": "npm run test:config && npm run atoz --workspaces --if-present && npm run lint && bash deploy/verify.sh",
        "test:config": "node --test tools/__tests__/*.test.mjs",
        "postatoz": "echo '✅ ATOZ PASS'",
        "predev": "npm run build -w libs",
        "dev": "concurrently 'npm:dev:*'",
        "dev:common": "npm run dev -w libs/common",
        "dev:testing": "npm run dev -w libs/testing",
        "dev:api": "npm run dev -w apps/api",
        "dev:console": "npm run dev -w apps/console",
        "dev:user-app": "npm run dev -w apps/user-app"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1114.0",
        "@aws-sdk/s3-presigned-post": "3.1114.0",
        "@aws-sdk/s3-request-presigner": "3.1114.0",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@nestjs/common": "11.2.1",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.1",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/mongoose": "11.0.4",
        "@nestjs/terminus": "11.1.1",
        "@nestjs/testing": "11.2.1",
        "@temporalio/client": "1.22.0",
        "@temporalio/testing": "1.22.0",
        "@temporalio/worker": "1.22.0",
        "@testcontainers/mongodb": "12.1.0",
        "@testcontainers/nats": "12.1.0",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.3",
        "@types/superagent": "8.1.11",
        "@typescript-eslint/parser": "8.67.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "concurrently": "10.0.5",
        "eslint": "9.39.5",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "express": "5.2.1",
        "globals": "17.11.0",
        "husky": "9.1.7",
        "ioredis": "6.0.0",
        "jest": "30.4.2",
        "joi": "18.2.5",
        "lint-staged": "17.3.0",
        "mongodb": "7.5.0",
        "mongoose": "9.9.3",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.1.0",
        "ts-jest": "29.4.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": "^24.15.0"
    },
    "allowScripts": {
        "@swc/core@1.15.33": true,
        "bcrypt@6.0.0": true,
        "cpu-features@0.0.10": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "protobufjs@7.6.5": true,
        "ssh2@1.17.0": true,
        "unrs-resolver@1.11.1": true
    },
    "overrides": {
        "next@16.3.1": {
            "postcss": "8.5.26",
            "sharp": "0.35.3"
        }
    }
}
