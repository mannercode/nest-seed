{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "build:libs": "pnpm -F './libs/**' --fail-if-no-match build",
        "pretest": "pnpm run build:libs",
        "test": "bash infra/stack.sh group pnpm -r --workspace-concurrency=1 run --if-present test",
        "test:api:file": "bash tools/test-api-file.sh",
        "prelint": "pnpm run build:libs",
        "lint": "run-p lint:**",
        "lint:workspaces": "pnpm -r run --if-present lint",
        "lint:format": "prettier --check .",
        "lint:code": "oxlint .",
        "lint:md": "docker run --rm -v \"${WORKSPACE_ROOT:?}:/workspace\" lycheeverse/lychee --offline --include-fragments --hidden --extensions=md /workspace",
        "lint:shell": "bash -O globstar -O dotglob -o pipefail -c \"git ls-files -z -- '*.sh' '.husky/*' | xargs -0 shellcheck --severity=warning -ax && shellcheck --shell=bash --severity=warning apps/api/api-docs/**/*.spec apps/api/api-docs/run.cfg\""
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1175.0",
        "@aws-sdk/s3-presigned-post": "3.1175.0",
        "@aws-sdk/s3-request-presigner": "3.1175.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@mannercode/tools": "workspace:*",
        "@nestjs/common": "12.6.0",
        "@nestjs/config": "12.1.1",
        "@nestjs/core": "12.6.0",
        "@nestjs/jwt": "12.0.5",
        "@nestjs/platform-express": "12.6.0",
        "@nestjs/testing": "12.6.0",
        "@testcontainers/mongodb": "12.2.2",
        "@testcontainers/nats": "12.2.2",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.4.4",
        "express": "5.3.0",
        "husky": "9.1.7",
        "ioredis": "6.1.0",
        "lint-staged": "17.6.2",
        "mongodb": "7.9.1",
        "npm-run-all": "4.1.5",
        "oxlint": "1.94.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.2.2",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}
