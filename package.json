{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "build:libs": "pnpm -r -F './libs/**' --fail-if-no-match run build",
        "prelint": "pnpm run build:libs",
        "lint": "pnpm run '/^lint:/'",
        "lint:workspaces": "pnpm -r run --if-present lint",
        "lint:format": "prettier --check .",
        "lint:code": "oxlint .",
        "lint:links": "pnpm -C tools run lint:links",
        "lint:shell": "pnpm -C tools run lint:shell",
        "pretest": "pnpm run build:libs",
        "test": "pnpm -r run -s --if-present test",
        "e2e": "pnpm -C tests/web run e2e",
        "race": "pnpm -C tests/api run race",
        "preatoz": "pnpm install --frozen-lockfile && bash infra/reset.sh",
        "atoz": "pnpm run -s '/^atoz:/'",
        "atoz:01-lint": "pnpm run lint",
        "atoz:02-test": "pnpm run test",
        "atoz:03-build-web": "pnpm -C apps/web run build",
        "atoz:04-e2e": "pnpm run e2e",
        "XXXbuild": "pnpm --recursive --if-present run build",
        "XXXpredev": "pnpm run build:libs",
        "XXXdev": "pnpm run --workspace-concurrency=Infinity '/^XXXdev:/'",
        "XXXdev:common": "pnpm --dir libs/common run dev",
        "XXXdev:api": "pnpm --dir apps/api run dev",
        "XXXdev:restate": "node apps/api/scripts/register-restate.cjs",
        "XXXdev:web": "pnpm --dir apps/web run dev",
        "XXXformat": "prettier --write .",
        "XXXe2e:list": "pnpm --dir tests/web run e2e:list",
        "XXXe2e:ui": "pnpm --dir tests/web run e2e:ui",
        "XXXe2e:report": "pnpm --dir tests/web run e2e:report",
        "XXXbenchmark": "pnpm --dir tests/api run benchmark"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1173.0",
        "@aws-sdk/s3-presigned-post": "3.1173.0",
        "@aws-sdk/s3-request-presigner": "3.1173.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@mannercode/tools": "workspace:*",
        "@nestjs/common": "12.6.0",
        "@nestjs/config": "12.1.1",
        "@nestjs/core": "12.6.0",
        "@nestjs/jwt": "12.0.5",
        "@nestjs/platform-express": "12.6.0",
        "@nestjs/testing": "12.6.0",
        "@testcontainers/mongodb": "12.2.2",
        "@testcontainers/nats": "12.2.2",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.4.4",
        "express": "5.3.0",
        "husky": "9.1.7",
        "ioredis": "6.0.0",
        "lint-staged": "17.6.1",
        "mongodb": "7.9.1",
        "oxlint": "1.94.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.2.2",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}
