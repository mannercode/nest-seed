{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.24.0",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "build": "pnpm --recursive --workspace-concurrency=1 --if-present run build",
        "clean": "node tools/clean-workspace.mjs",
        "lint": "pnpm --recursive --workspace-concurrency=1 --if-present run lint && pnpm run lint:root",
        "lint:root": "prettier --check . && lychee --offline --include-fragments '*.md' 'docs/**/*.md' && node tools/lint-shell.mjs",
        "format": "pnpm --recursive --workspace-concurrency=1 --if-present run format",
        "postformat": "prettier --write .",
        "pretest": "pnpm --recursive --filter './libs/**' --workspace-concurrency=1 --fail-if-no-match run build",
        "test": "pnpm --recursive --workspace-concurrency=1 --if-present run test",
        "posttest": "node tests/show-results.mjs test",
        "e2e": "pnpm --filter './tests/web' --fail-if-no-match run e2e",
        "e2e:list": "pnpm --filter './tests/web' --fail-if-no-match run e2e:list",
        "e2e:ui": "pnpm --filter './tests/web' --fail-if-no-match run e2e:ui",
        "e2e:report": "pnpm --filter './tests/web' --fail-if-no-match run e2e:report",
        "race": "bash tests/api-race/runner.sh",
        "benchmark:api": "bash tests/api-benchmark/runner.sh",
        "preatoz": "pnpm run clean && bash infra/reset.sh && for i in 1 2 3 4 5; do pnpm install --frozen-lockfile && break; [ $i = 5 ] && exit 1; sleep $((i*10)); done",
        "atoz": "pnpm run test:config && pnpm --recursive --filter './libs/**' --workspace-concurrency=1 --fail-if-no-match run atoz && pnpm --recursive --filter '!./libs/**' --workspace-concurrency=1 --if-present run atoz && pnpm run lint:root && bash deploy/verify.sh",
        "postatoz": "node tests/show-results.mjs atoz",
        "test:config": "node --test tools/__tests__/*.test.mjs",
        "predev": "pnpm --recursive --filter './libs/**' --workspace-concurrency=1 --fail-if-no-match run build",
        "dev": "concurrently 'pnpm:dev:*'",
        "dev:common": "pnpm --filter './libs/common' --fail-if-no-match run dev",
        "dev:api": "pnpm --filter './apps/api' --fail-if-no-match run dev",
        "dev:restate": "node apps/api/scripts/register-restate.cjs",
        "dev:console": "pnpm --filter './apps/console' --fail-if-no-match run dev",
        "dev:user-app": "pnpm --filter './apps/user-app' --fail-if-no-match run dev"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1118.0",
        "@aws-sdk/s3-presigned-post": "3.1118.0",
        "@aws-sdk/s3-request-presigner": "3.1118.0",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@mannercode/dev-tools": "workspace:*",
        "@nestjs/common": "12.0.1",
        "@nestjs/config": "12.0.0",
        "@nestjs/core": "12.0.1",
        "@nestjs/jwt": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@testcontainers/mongodb": "12.1.0",
        "@testcontainers/nats": "12.1.0",
        "@types/express": "5.0.6",
        "@types/node": "26.4.0",
        "@vitest/coverage-v8": "4.1.11",
        "concurrently": "10.0.5",
        "eslint": "9.39.5",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "express": "5.2.1",
        "globals": "17.11.0",
        "husky": "9.1.7",
        "ioredis": "6.0.0",
        "lint-staged": "17.3.0",
        "mongodb": "7.5.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.1.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vitest": "4.1.11"
    }
}
