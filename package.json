{
    "name": "nest-seed",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "build": "pnpm --recursive --if-present run build",
        "build:libs": "pnpm --recursive --filter './libs/**' --fail-if-no-match run build",
        "compose:tools": "docker compose --project-name \"${COMPOSE_PROJECT_NAME}-tools\" -f tools/compose.yml",
        "prelint": "pnpm run build:libs",
        "lint": "pnpm --recursive --if-present run lint && pnpm run lint:root && pnpm run lint:code && pnpm run lint:links && pnpm run lint:shell",
        "lint:root": "prettier --check --ignore-unknown '*'",
        "lint:code": "oxlint .",
        "lint:links": "pnpm compose:tools run --rm lychee",
        "lint:shell": "git ls-files -z '*.sh' '.husky/*' | xargs -0 shellcheck --severity=warning -x",
        "format": "prettier --write .",
        "pretest": "pnpm run build:libs",
        "test": "pnpm run test:workspaces",
        "test:workspaces": "pnpm --recursive --workspace-concurrency=1 --if-present run test",
        "e2e": "pnpm --dir tests/web run e2e",
        "e2e:list": "pnpm --dir tests/web run e2e:list",
        "e2e:ui": "pnpm --dir tests/web run e2e:ui",
        "e2e:report": "pnpm --dir tests/web run e2e:report",
        "api-docs": "pnpm --dir tests/api run api-docs",
        "race": "pnpm --dir tests/api run race",
        "benchmark": "pnpm --dir tests/api run benchmark",
        "preatoz": "pnpm install --frozen-lockfile && bash infra/reset.sh",
        "atoz": "pnpm run lint && pnpm --dir infra/tests run test:restate-recovery && pnpm run test:workspaces && pnpm --dir apps/web run build && CI=1 pnpm run e2e && pnpm run api-docs",
        "predev": "pnpm run build:libs",
        "dev": "concurrently 'pnpm:dev:*'",
        "dev:common": "pnpm --dir libs/common run dev",
        "dev:api": "pnpm --dir apps/api run dev",
        "dev:restate": "node apps/api/scripts/register-restate.cjs",
        "dev:web": "pnpm --dir apps/web run dev"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1173.0",
        "@aws-sdk/s3-presigned-post": "3.1173.0",
        "@aws-sdk/s3-request-presigner": "3.1173.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@mannercode/dev-tools": "workspace:*",
        "@nestjs/common": "12.6.0",
        "@nestjs/config": "12.1.1",
        "@nestjs/core": "12.6.0",
        "@nestjs/jwt": "12.0.5",
        "@nestjs/platform-express": "12.6.0",
        "@nestjs/testing": "12.6.0",
        "@testcontainers/mongodb": "12.2.2",
        "@testcontainers/nats": "12.2.2",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "concurrently": "10.0.7",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-allowed-dependencies": "3.1.0",
        "eslint-plugin-boundaries": "7.4.4",
        "express": "5.3.0",
        "husky": "9.1.7",
        "ioredis": "6.0.0",
        "lint-staged": "17.6.1",
        "mongodb": "7.9.1",
        "oxlint": "1.94.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "testcontainers": "12.2.2",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}
