{
    "name": "@mannercode/vitest-helpers",
    "version": "0.0.1",
    "private": true,
    "main": "./index.js",
    "types": "./index.d.ts",
    "scripts": {
        "test": "node --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test __tests__/*.test.js",
        "lint": "for file in index.js __tests__/*.test.js; do node --check \"$file\"; done && prettier --check index.js index.d.ts '__tests__/*.test.js' package.json",
        "format": "prettier --write index.js index.d.ts '__tests__/*.test.js' package.json",
        "atoz": "pnpm run lint && pnpm test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1116.0"
    }
}
